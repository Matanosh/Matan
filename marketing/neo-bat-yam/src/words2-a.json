ור בצפון מערב בת ים, קרוב מאוד לגבול תל אביב יפו והנתון שאני הכי אוהב מאה ועשרים מטר בלבד מתחנת רוטשילד של הרכבת הקלה.","wordRange":[24,53]},{"id":"s5","speaker":"Speaker 0","start":25.52,"end":28.48,"text":"זאת אומרת התחנה ממש מעבר לפינה.","wordRange":[54,59]},{"id":"s6","speaker":"Speaker 0","start":29.38,"end":41.12,"text":"אנחנו בונים כאן שני מגדלים של עשרים וחמש קומות, מגדלים מעוצבים עם קווים רכים ומרפסות מעוגלות שמתנשאים מעל העיר עם נוף מרהיב לים.","wordRange":[60,82]},{"id":"s7","speaker":"Speaker 0","start":41.88,"end":45.08,"text":"בואו נכנס כבר לובי מרגישים את ההבדל.","wordRange":[83,89]},{"id":"s8","speaker":"Speaker 0","start":45.8,"end":49.88,"text":"תכנון אדריכלי מעוצב עם ירידה לפרטים הקטנים ביותר.","wordRange":[90,97]},{"id":"s9","speaker":"Speaker 0","start":50.58,"end":56.52,"text":"עץ חם, אור רך, קירות מעוגלים כל פרט כאן נבחר בקפידה.","wordRange":[98,108]},{"id":"s10","speaker":"Speaker 0","start":57.58,"end":72.38,"text":"מכאן המעליות לוקחות אתכם לקומה וכאן נמצא אחד הדברים הכי חשובים בפרויקט ארבע דירות בלבד בכל קומה פחות שכנים במסדרון, יותר פרטיות והרגשה","wordRange":[109,131]},{"id":"s11","speaker":"Speaker 0","start":72.42,"end":73.42,"text":"אמיתית של בית.","wordRange":[132,134]},{"id":"s12","speaker":"Speaker 0","start":74.3,"end":76.36,"text":"ועכשיו לדירות עצמן.","wordRange":[135,137]},{"id":"s13","speaker":"Speaker 0","start":77.18,"end":89.46,"text":"תמהיל הדירות מגוון דירות שלוש, ארבע וחמש חדרים, מיני פנטהאוזים ופנטהאוזים מרהיבים והכל במפרט טכני גבוה ביותר.","wordRange":[138,154]},{"id":"s14","speaker":"Speaker 0","start":90.62,"end":94.46,"text":"תסתכלו על הסלון הזה, חלונות גדולים הרבה.","wordRange":[155,161]}],"model":"elevenlabs-scribe"}