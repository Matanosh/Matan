":37.52,"end":39.32,"text":"כבר בלובי מרגישים את ההבדל.","wordRange":[85,89]},{"id":"s10","speaker":"Speaker 0","start":39.78,"end":46.56,"text":"תכנון אדריכלי מעוצב עם ירידה לפרטים הקטנים ביותר עץ חם, עור רך, קירות מעוגלים.","wordRange":[90,103]},{"id":"s11","speaker":"Speaker 0","start":46.9,"end":48.68,"text":"כל פרט כאן נבחר בקפידה.","wordRange":[104,108]},{"id":"s12","speaker":"Speaker 0","start":49.68,"end":55.16,"text":"מכאן המעליות לוקחות אתכם לקומה וכאן נמצא אחד הדברים הכי חשובים בפרויקט.","wordRange":[109,120]},{"id":"s13","speaker":"Speaker 0","start":55.6,"end":62.3,"text":"ארבע דירות בלבד בכל קומה, פחות שכנים במסדרון, יותר פרטיות והרגשה אמיתית של בית.","wordRange":[121,134]},{"id":"s14","speaker":"Speaker 0","start":63.24,"end":64.66,"text":"ועכשיו לדירות עצמן.","wordRange":[135,137]},{"id":"s15","speaker":"Speaker 0","start":65.2,"end":75.08,"text":"תמהיל הדירות מגוון דירות שלוש, ארבע וחמש חדרים, מיני פנטהאוזים ופנטהאוזים מרהיבים והכל במפרט טכני גבוה ביותר.","wordRange":[138,154]}],"model":"elevenlabs-scribe"}